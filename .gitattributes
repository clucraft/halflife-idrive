# Unix line endings in the working tree on every OS: the app is built on the head unit
* text=auto eol=lf
# Shell scripts are piped to the head unit's shell: keep them LF on Windows too.
*.sh        text eol=lf
*.service   text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.md        text
*.png       binary
*.tgz       binary
*.tar.gz    binary
*.patch     text eol=lf
*.env       text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.socket   text eol=lf
*.conf     text eol=lf
*.jpg      binary
*.so       binary
*.pk3      binary
native/clucraft-halflife/bin/clucraft-hl binary

build/
out/
dist/
node_modules/
*.o
*.obj
*.log
*.tmp
frames/
*.ppm
*.tga

# Head-unit access: keys and addresses stay out of the repo
*.pem
*.key
id_*
.env
.env.*
local.config.json

# Editors and OS
.vscode/
.idea/
Thumbs.db
.DS_Store

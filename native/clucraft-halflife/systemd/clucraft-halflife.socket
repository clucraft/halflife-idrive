# SPDX-License-Identifier: GPL-3.0-or-later
# (After clucraft-plex.socket, clucraft/plex-idrive, from amn-iptv's, M850i-amn/idrive7-apps.)
[Unit]
Description=clucraft-halflife control socket (the app Half-Life)

[Socket]
# The app's connection starts clucraft-halflife.service; nothing of it runs before, at boot included. Root's
# alone when made; sockgroup.js then gives it the Half-Life app's own group (0660), not tm_oap_app, which every
# app has. The socket file goes when the socket stops (an uninstall).
ListenStream=/run/clucraft-halflife.sock
SocketMode=0600
RemoveOnStop=yes
ExecStartPost=-/bin/sh -c 'ulimit -c 1; exec /usr/bin/node /var/opt/clucraft-halflife/current/sockgroup.js'
# no core dump from the command above to the crash handler
LimitCORE=1

[Install]
WantedBy=sockets.target
